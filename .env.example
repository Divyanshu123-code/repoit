# ==============================================================================
# RepoPilot AI - Environment Configuration Example
# Copy this file to `.env` and fill in your secrets and configuration values.
# ==============================================================================

# Application & Runtime
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-to-a-secure-random-secret-key-in-production

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Web Frontend (Vite)
VITE_API_URL=http://localhost:8000

# PostgreSQL + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=repopilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/repopilot

# Redis & Job Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI & LLM Providers (Accessed ONLY via apps/api/app/ai/providers/)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ML Risk Model Configuration
MODEL_ARTIFACTS_DIR=packages/ml/artifacts
MODEL_VERSION=v0.1.0

